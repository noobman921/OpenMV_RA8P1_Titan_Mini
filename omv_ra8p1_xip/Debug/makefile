omv_ra8p1_xip.elf: $(OBJS) $(USER_OBJS) $(LINKER_SCRIPT)
	$(file > omv_ra8p1_xip.elf.in,-mthumb -mfloat-abi=hard -mcpu=cortex-m85+nopacbti -O2 -fmessage-length=0 -fsigned-char -ffunction-sections -fdata-sections -fno-strict-aliasing -w -Wunused -Wuninitialized -Wall -Wextra -Wmissing-declarations -Wconversion -Wpointer-arith -Wshadow -Wlogical-op -Waggregate-return -Wfloat-equal -g -T "fsp.ld" -Xlinker --gc-sections -L "D:\\Single-chip\\OpenMV\\p1-repo\\omv_ra8p1_xip/script" -Wl,-Map,"omv_ra8p1_xip.map" --specs=nano.specs -Wl,--wrap=mp_hal_stdout_tx_strn -Wl,--wrap=mp_hal_stdio_poll -o "omv_ra8p1_xip.elf" $(OBJS) $(USER_OBJS) $(LIBS))
	@echo Building target: $@ && arm-none-eabi-g++ @"omv_ra8p1_xip.elf.in"
omv_ra8p1_xip.srec: omv_ra8p1_xip.elf
	arm-none-eabi-objcopy -O srec "omv_ra8p1_xip.elf"  "omv_ra8p1_xip.srec"
